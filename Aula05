delimiter //
create or replace procedure sp_lacoWhileCont(varPasso int)
begin
	declare varContador int;
    declare varTotalPedidos int;
	set varContador = 0;

-- Busca quantidade de pedidos

	select count(*) into varTotalPedidos from orders;

	while (varContador <= varTotalPedidos) do
		select * from orders
		limit varContador, varPasso;
		set varContador = varContador + varPasso;
	end while;
end;
//

call sp_lacoWhileCont(6);

