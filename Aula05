
-- Procedure Simples

delimiter $$
create or replace procedure sp_listaCliente()

begin
	select customerid, contactname, phone, address
	from customers;
end;
$$

-- Chamada de Procedure

call sp_listaCliente();

drop procedure sp_listaCliente;

delimiter $$
create procedure sp_listaClienteFiltro(in varNomeContato varchar(30))

begin

	select customerid, contactname, phone, address
	from customers
    where contactname = varNomeContato;
    
end;
$$

call sp_listaClienteFiltro('Antonio Moreno')

delimiter //
create or replace procedure sp_listaPedidosFiltros(in varCodPedido int,
												   in varDataPedido datetime)

begin
	select orderId, customerid, orderdate, shipvia
    from orders
    where orderid = varCodPedido or orderdate = varDataPedido;
    
end;
//

call sp_listaPedidosFiltros(10254,'1996-07-11');

-- Procedure com variaveis de entra e if

delimiter //
create or replace procedure sp_listaPedidosFiltrosIf(in varCodPedido int,
												   in varDataPedido datetime)
begin
    if varCodPedido is null and varDataPedido is null then
			select orderId, customerid, orderdate, shipvia
            from orders;
	else
		select orderId, customerid, orderdate, shipvia
		from orders
		where orderid = varCodPedido or orderdate = varDataPedido;
	end if;
end;
//

call sp_listaPedidosFiltrosIf(null, null);

Delimiter //
create or replace procedure sp_atualizaProd(varCodProd int, varPrecoProd dec(10,4))

begin
	if (varCodProd is not null and varPrecoProd is not null) then
		update products
		set UnitPrice = varPrecoProd
		where productId = varCodProd;
	else
		select 'Os parametros estão nulos';
    end if;
end;
//

call sp_atualizaProd(1, 100);

call sp_atualizaProd(null, 100);

select * from products;

delimiter //
create or replace procedure sp_estoqueProdutos(varCodProd int)
begin
	declare varQtdEstoque int;
    declare varMsg varchar(50);
    
    -- buscando a quantidade em estoque do produto
    
    select unitsinstock into varQtdEstoque
    from products
    where productid = varCodProd;
    
    if (varQtdEstoque >= 100) then
		set varMsg = concat('O estoque do produto', varCodProd, ' está alto : ', varQtdEstoque);
	else
		if (varQtdEstoque <= 99 and varQtdEstoque >= 11) then
			set varMsg = concat('O estoque do produto', varCodProd, ' está ok : ', varQtdEstoque);
		else
			set varMsg = concat('O estoque do produto', varCodProd, ' está baixo : ', varQtdEstoque);
		end if;
	end if;
    -- imprime a variavel com a frase do estoque
    select varMsg;
end;
//

call sp_estoqueProdutos(1);
select * from products where productid = 1;

delimiter //
create or replace procedure sp_estoqueProdutosWhen(varCodProd int)
begin
	declare varQtdEstoque int;
    declare varMsg varchar(50);
    
    -- buscando a quantidade em estoque do produto
    
    select unitsinstock into varQtdEstoque
    from products
    where productid = varCodProd;
    
    -- exemplo com switch case
    
    case when varQtdEstoque >= 100 then
		set varMsg = concat('O estoque do produto', varCodProd, ' está alto : ', varQtdEstoque);
	when (varQtdEstoque <= 99 and varQtdEstoque >= 11) then
			set varMsg = concat('O estoque do produto', varCodProd, ' está ok : ', varQtdEstoque);
		else
			set varMsg = concat('O estoque do produto', varCodProd, ' está baixo : ', varQtdEstoque);
	end case;
    -- imprime a variavel com a frase do estoque
    select varMsg;
end;
//

call sp_estoqueProdutosWhen(2);
select * from products where productid = 2;

